{
  "name": "@mipsel64/pi-fx-ui",
  "version": "0.1.0",
  "description": "Make Pi look like Vercel fx: monochrome themes, ┃ composer, ● tool rows, one-line footer",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mipsel64/pi-fx-ui.git"
  },
  "bugs": {
    "url": "https://github.com/mipsel64/pi-fx-ui/issues"
  },
  "homepage": "https://github.com/mipsel64/pi-fx-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "themes"
  ],
  "keywords": [
    "pi-package",
    "pi-theme",
    "fx"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "scripts": {
    "check": "tsc",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
